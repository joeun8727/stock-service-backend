# 이 파일을 복사해 .env로 저장 후 실제 값으로 채우세요: cp .env.example .env

# Docker Compose — MySQL
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_DATABASE=stocknews
MYSQL_USER=stocknews
MYSQL_PASSWORD=your_password_here

# 외부 API 키 (각 서비스에서 발급)
# Finnhub: https://finnhub.io  (무료 티어 분당 60콜)
FINNHUB_API_KEY=your_finnhub_api_key_here

# FRED: https://fred.stlouisfed.org/docs/api/api_key.html  (무료)
FRED_API_KEY=your_fred_api_key_here

# Google AI Studio: https://aistudio.google.com/app/apikey  (Gemini 2.5 Flash Lite 무료 티어)
GEMINI_API_KEY=your_gemini_api_key_here
